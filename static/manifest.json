{
  "manifest_version": 3,
  "name": "pinmix",
  "version": "1.0.0",
  "description": "shuffle any pinterest board into a new board in one click",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.pinterest.com/*",
        "https://*.pinterest.co.uk/*",
        "https://*.pinterest.ca/*",
        "https://*.pinterest.com.au/*",
        "https://*.pinterest.com.mx/*",
        "https://*.pinterest.de/*",
        "https://*.pinterest.fr/*",
        "https://*.pinterest.es/*",
        "https://*.pinterest.it/*",
        "https://*.pinterest.pt/*",
        "https://*.pinterest.ie/*",
        "https://*.pinterest.ch/*",
        "https://*.pinterest.at/*",
        "https://*.pinterest.se/*",
        "https://*.pinterest.dk/*",
        "https://*.pinterest.nz/*",
        "https://*.pinterest.jp/*",
        "https://*.pinterest.co.kr/*",
        "https://*.pinterest.ph/*",
        "https://*.pinterest.cl/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["*.js"],
      "matches": [
        "https://*.pinterest.com/*",
        "https://*.pinterest.co.uk/*",
        "https://*.pinterest.ca/*",
        "https://*.pinterest.com.au/*",
        "https://*.pinterest.com.mx/*",
        "https://*.pinterest.de/*",
        "https://*.pinterest.fr/*",
        "https://*.pinterest.es/*",
        "https://*.pinterest.it/*",
        "https://*.pinterest.pt/*",
        "https://*.pinterest.ie/*",
        "https://*.pinterest.ch/*",
        "https://*.pinterest.at/*",
        "https://*.pinterest.se/*",
        "https://*.pinterest.dk/*",
        "https://*.pinterest.nz/*",
        "https://*.pinterest.jp/*",
        "https://*.pinterest.co.kr/*",
        "https://*.pinterest.ph/*",
        "https://*.pinterest.cl/*"
      ]
    }
  ]
}
